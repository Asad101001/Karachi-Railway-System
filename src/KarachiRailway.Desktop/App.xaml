<Application x:Class="KarachiRailway.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KarachiRailway.Desktop"
             xmlns:conv="clr-namespace:KarachiRailway.Desktop.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ══ CONVERTERS ════════════════════════════════════════════════════ -->
        <conv:BoolToVisibilityConverter         x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVisibility"/>
        <conv:InverseBoolConverter              x:Key="InverseBool"/>
        <conv:DoubleToPercentConverter          x:Key="DoubleToPercent"/>
        <conv:DoubleToFixedStringConverter      x:Key="DoubleToFixed"/>
        <conv:HexColorToBrushConverter          x:Key="HexToBrush"/>
        <conv:UtilizationToBrushConverter       x:Key="UtilToBrush"/>
        <conv:MultiplyConverter                 x:Key="Multiply"/>

        <!-- ══ GREEN + GOLD COLOR PALETTE (LIGHT THEME) ══════════════════════ -->
        <!-- Background layers — crisp white and light grays -->
        <Color x:Key="BackgroundDeep">#F3F4F6</Color>      <!-- Gray 100 -->
        <Color x:Key="BackgroundCard">#FFFFFF</Color>      <!-- White -->
        <Color x:Key="BackgroundPanel">#F9FAFB</Color>     <!-- Gray 50 -->
        <Color x:Key="BackgroundElevated">#FFFFFF</Color>  <!-- White -->
        <Color x:Key="BackgroundSidebar">#0F172A</Color>   <!-- Slate 900 (Dark sidebar contrast) -->

        <!-- Primary green accents -->
        <Color x:Key="AccentGreen">#16A34A</Color>         <!-- Green 600 -->
        <Color x:Key="AccentGreenBright">#22C55E</Color>   <!-- Green 500 -->
        <Color x:Key="AccentGreenDim">#15803D</Color>      <!-- Green 700 -->
        <Color x:Key="AccentGreenSoft">#DCFCE7</Color>     <!-- Green 100 (for backgrounds) -->

        <!-- Gold / yellow accents -->
        <Color x:Key="AccentGold">#D97706</Color>          <!-- Amber 600 -->
        <Color x:Key="AccentGoldBright">#F59E0B</Color>    <!-- Amber 500 -->
        <Color x:Key="AccentGoldDim">#B45309</Color>       <!-- Amber 700 -->
        <Color x:Key="AccentAmber">#D97706</Color>

        <!-- Supporting colours -->
        <Color x:Key="AccentRed">#DC2626</Color>           <!-- Red 600 -->
        <Color x:Key="AccentRedBright">#EF4444</Color>     <!-- Red 500 -->
        <Color x:Key="AccentBlue">#2563EB</Color>          <!-- Blue 600 -->
        <Color x:Key="AccentBlueBright">#3B82F6</Color>    <!-- Blue 500 -->

        <!-- Text -->
        <Color x:Key="TextPrimary">#111827</Color>         <!-- Gray 900 -->
        <Color x:Key="TextSecondary">#4B5563</Color>       <!-- Gray 600 -->
        <Color x:Key="TextMuted">#9CA3AF</Color>           <!-- Gray 400 -->

        <!-- Borders -->
        <Color x:Key="Border">#E5E7EB</Color>              <!-- Gray 200 -->
        <Color x:Key="BorderHover">#16A34A</Color>         <!-- Green 600 -->
        <Color x:Key="BorderGold">#F59E0B</Color>

        <!-- ── Solid Brushes ──────────────────────────────────────────────── -->
        <SolidColorBrush x:Key="BackgroundDeepBrush"     Color="{StaticResource BackgroundDeep}"/>
        <SolidColorBrush x:Key="BackgroundCardBrush"     Color="{StaticResource BackgroundCard}"/>
        <SolidColorBrush x:Key="BackgroundPanelBrush"    Color="{StaticResource BackgroundPanel}"/>
        <SolidColorBrush x:Key="BackgroundElevatedBrush" Color="{StaticResource BackgroundElevated}"/>
        <SolidColorBrush x:Key="BackgroundSidebarBrush"  Color="{StaticResource BackgroundSidebar}"/>
        <SolidColorBrush x:Key="AccentGreenBrush"        Color="{StaticResource AccentGreen}"/>
        <SolidColorBrush x:Key="AccentGreenBrightBrush"  Color="{StaticResource AccentGreenBright}"/>
        <SolidColorBrush x:Key="AccentGreenDimBrush"     Color="{StaticResource AccentGreenDim}"/>
        <SolidColorBrush x:Key="AccentGoldBrush"         Color="{StaticResource AccentGold}"/>
        <SolidColorBrush x:Key="AccentGoldBrightBrush"   Color="{StaticResource AccentGoldBright}"/>
        <SolidColorBrush x:Key="AccentAmberBrush"        Color="{StaticResource AccentAmber}"/>
        <SolidColorBrush x:Key="AccentRedBrush"          Color="{StaticResource AccentRed}"/>
        <SolidColorBrush x:Key="AccentBlueBrush"         Color="{StaticResource AccentBlue}"/>
        <SolidColorBrush x:Key="AccentBlueBrightBrush"   Color="{StaticResource AccentBlueBright}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimary}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondary}"/>
        <SolidColorBrush x:Key="TextMutedBrush"          Color="{StaticResource TextMuted}"/>
        <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource Border}"/>
        <SolidColorBrush x:Key="BorderHoverBrush"        Color="{StaticResource BorderHover}"/>
        <SolidColorBrush x:Key="BorderGoldBrush"         Color="{StaticResource BorderGold}"/>

        <!-- Gradient brushes -->
        <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F9FAFB" Offset="0.5"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#1E293B" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#F9FAFB" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldAccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D97706" Offset="0.0"/>
            <GradientStop Color="#F59E0B" Offset="0.5"/>
            <GradientStop Color="#D97706" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GreenButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#22C55E" Offset="0.0"/>
            <GradientStop Color="#16A34A" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoldButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F59E0B" Offset="0.0"/>
            <GradientStop Color="#D97706" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AmberButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F59E0B" Offset="0.0"/>
            <GradientStop Color="#B45309" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RedButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF4444" Offset="0.0"/>
            <GradientStop Color="#DC2626" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#22C55E" Offset="0.0"/>
            <GradientStop Color="#15803D" Offset="1.0"/>
        </LinearGradientBrush>
        <!-- Sidebar active tab indicator gradient -->
        <LinearGradientBrush x:Key="SidebarActiveGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#22C55E22" Offset="0.0"/>
            <GradientStop Color="#22C55E44" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- ══ EASING FUNCTIONS ══════════════════════════════════════════════ -->
        <CubicEase  x:Key="EaseOut"   EasingMode="EaseOut"/>
        <CubicEase  x:Key="EaseInOut" EasingMode="EaseInOut"/>
        <BackEase   x:Key="EaseBack"  EasingMode="EaseOut" Amplitude="0.3"/>
        <SineEase   x:Key="SineInOut" EasingMode="EaseInOut"/>

        <!-- ══ TYPOGRAPHY ════════════════════════════════════════════════════ -->
        <FontFamily x:Key="OutfitFont">pack://application:,,,/KarachiRailway.Desktop;component/Assets/Fonts/#Outfit</FontFamily>

        <Style x:Key="HeadingLarge" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource OutfitFont}"/>
            <Setter Property="FontSize"    Value="26"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style x:Key="HeadingMedium" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource OutfitFont}"/>
            <Setter Property="FontSize"    Value="18"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style x:Key="HeadingSmall" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource OutfitFont}"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Foreground"        Value="{StaticResource AccentGoldBrush}"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource OutfitFont}"/>
            <Setter Property="FontSize"    Value="34"/>
            <Setter Property="FontWeight"  Value="Black"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" ShadowDepth="2" BlurRadius="4" Opacity="0.1"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- ══ TEXTBOX ═══════════════════════════════════════════════════════ -->
        <Style x:Key="ParamTextBox" TargetType="TextBox">
            <Setter Property="Background"        Value="#050E05"/>
            <Setter Property="Foreground"        Value="#FFFFFF"/>
            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="8,6"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontFamily"        Value="{StaticResource OutfitFont}"/>
            <Setter Property="MinWidth"          Value="90"/>
            <Setter Property="CaretBrush"        Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="SelectionBrush"    Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="GotFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="Border"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="{StaticResource AccentGreen}"
                                            Duration="0:0:0.2">
                                            <ColorAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ColorAnimation.EasingFunction>
                                        </ColorAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="LostFocus">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetName="Border"
                                            Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                            To="{StaticResource Border}"
                                            Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ LABEL ═════════════════════════════════════════════════════════ -->
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══ SIDEBAR NAV BUTTON ════════════════════════════════════════════ -->
        <Style x:Key="SideNavButton" TargetType="Button">
            <Setter Property="FontFamily"         Value="Segoe UI"/>
            <Setter Property="FontSize"           Value="20"/>
            <Setter Property="FontWeight"         Value="Regular"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Width"              Value="68"/>
            <Setter Property="Height"             Value="62"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="0"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="Icon"
                                           Text="{TemplateBinding Content}"
                                           FontSize="22"
                                           HorizontalAlignment="Center"
                                           Foreground="#9CA3AF"/>
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe UI"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Foreground="#9CA3AF"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"     Property="Background" Value="#22C55E18"/>
                                <Setter TargetName="Bd"     Property="BorderBrush" Value="#22C55E55"/>
                                <Setter TargetName="Icon"   Property="Foreground" Value="#F8FAFC"/>
                                <Setter TargetName="Label"  Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active variant control template -->
        <ControlTemplate x:Key="SideNavActiveTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{StaticResource SidebarActiveGradient}"
                    CornerRadius="0"
                    BorderThickness="3,0,0,0"
                    BorderBrush="{StaticResource AccentGreenBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Content}"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentGreenBrush}"/>
                    <TextBlock Text="{TemplateBinding Tag}"
                               FontFamily="Segoe UI"
                               FontSize="9"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource AccentGreenBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </ControlTemplate>

        <!-- Active variant of sidebar nav button -->
        <Style x:Key="SideNavButtonActive" TargetType="Button" BasedOn="{StaticResource SideNavButton}">
            <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
        </Style>

        <!-- ══ BUTTON BASE ═══════════════════════════════════════════════════ -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="FontFamily"         Value="Segoe UI"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="BorderThickness"    Value="0"/>
            <Setter Property="Padding"            Value="20,10"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="BtnShadow"
                                                  Color="#000000"
                                                  ShadowDepth="0"
                                                  BlurRadius="0"
                                                  Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.06" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.06" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.0" Duration="0:0:0.18">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="Button.Click">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="0.95" Duration="0:0:0.07">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="0.95" Duration="0:0:0.07">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1.0" Duration="0:0:0.12" BeginTime="0:0:0.07">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1.0" Duration="0:0:0.12" BeginTime="0:0:0.07">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Specific button colours ──────────────────────────────────── -->
        <Style x:Key="ButtonStart" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource GreenButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ButtonPause" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource AmberButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ButtonResume" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource GreenButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ButtonStop" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource RedButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="ButtonReset" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="ButtonGold" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource GoldButtonGradient}"/>
            <Setter Property="Foreground" Value="#0A1A0A"/>
        </Style>

        <!-- ══ COMBOBOX ═══════════════════════════════════════════════════════ -->
        <Style x:Key="SpeedComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="#050E05"/>
            <Setter Property="Foreground"      Value="#FFFFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="{StaticResource OutfitFont}"/>
            <Setter Property="MinWidth"        Value="70"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Margin="8,0,4,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      RecognizesAccessKey="True"/>
                                    <Path Grid.Column="1"
                                          Data="M 0 0 L 8 0 L 4 5 Z"
                                          Width="8" Height="5"
                                          Fill="{StaticResource AccentGoldBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </ToggleButton>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource BackgroundPanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Popup" Property="MinHeight" Value="24"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#9CA3AF"/>
                        <Setter Property="Background" Value="{StaticResource BackgroundPanelBrush}"/>
                        <Setter Property="Padding" Value="8,4"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource BackgroundElevatedBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentGreenDimBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ CHECKBOX ═══════════════════════════════════════════════════════ -->
        <Style x:Key="ToggleCheck" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
        </Style>

        <!-- ══ SEPARATOR ══════════════════════════════════════════════════════ -->
        <Style x:Key="HSep" TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Margin"     Value="0,8"/>
        </Style>

        <!-- ══ PROGRESS BAR ═══════════════════════════════════════════════════ -->
        <Style x:Key="SimProgressBar" TargetType="ProgressBar">
            <Setter Property="Height"           Value="6"/>
            <Setter Property="Background"       Value="#112211"/>
            <Setter Property="Foreground"       Value="{StaticResource AccentGreenBrush}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="3"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"
                                    CornerRadius="3"
                                    Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator"
                                    CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#22C55E"
                                                      ShadowDepth="0"
                                                      BlurRadius="6"
                                                      Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ MODELLING TABLE HEADER CELL ═══════════════════════════════════ -->
        <Style x:Key="TableHeaderCell" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="FontSize"     Value="10"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="Foreground"   Value="{StaticResource AccentGoldBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TableDataCell" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="{StaticResource BackgroundElevatedBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1.03" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1.03" Duration="0:0:0.15">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
