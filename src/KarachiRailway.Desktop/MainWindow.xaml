<Window x:Class="KarachiRailway.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KarachiRailway.Desktop.ViewModels"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        mc:Ignorable="d"
        Title="Karachi Railway System — Simulation"
        Icon="/Assets/karachi-logo.png"
        Height="860" Width="1380"
        MinHeight="700" MinWidth="1100"
        Background="{StaticResource BackgroundDeepBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding StepCommand}"/>
        <KeyBinding Key="Right" Modifiers="Control" Command="{Binding StepCommand}"/>
    </Window.InputBindings>

    <!-- ══ WINDOW ENTRANCE FADE-IN ══════════════════════════════════════════ -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="RootGrid"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0" Duration="0:0:0.55">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid x:Name="RootGrid">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ══ TITLE BAR ════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource TitleBarGradient}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect Color="#001400" ShadowDepth="2" BlurRadius="12" Opacity="0.6"/>
            </Border.Effect>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8" Background="White" Padding="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/karachi-logo.png" Stretch="Uniform" SnapsToDevicePixels="True"/>
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="Karachi Railway System"
                               Style="{StaticResource HeadingMedium}"
                               FontSize="16"/>
                    <TextBlock Text="{Binding QueueModelHeaderText}"
                               Style="{StaticResource KpiLabel}"
                               Margin="0,2,0,0" Opacity="0.75"/>
                </StackPanel>

                <!-- Gold accent bar -->
                <Border Grid.Column="2" Height="3" VerticalAlignment="Bottom"
                        Background="{StaticResource GoldAccentGradient}"
                        Margin="20,0" CornerRadius="1.5"/>

                <!-- Status badge + controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="20" Padding="16,7"
                        VerticalAlignment="Center" BorderThickness="1"
                        Background="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=15}"
                        BorderBrush="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=40}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding StatusColor, Converter={StaticResource HexToBrush}}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="DotPulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.15"
                                                                         Duration="0:0:0.5">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="1.0" To="1.5"
                                                                         Duration="0:0:0.5">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="1.0" To="1.5"
                                                                         Duration="0:0:0.5">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="DotPulse"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN BODY ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="72"/>
                <!-- Content -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ─────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarGradient}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect Color="#001400" ShadowDepth="3" BlurRadius="12" Opacity="0.5" Direction="0"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Top" Margin="0,8,0,0">

                    <!-- Home -->
                    <Button Tag="Home" Command="{Binding NavigateCommand}" CommandParameter="Home">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabHome}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        🏠
                    </Button>

                    <!-- Modelling -->
                    <Button Tag="Model" Command="{Binding NavigateCommand}" CommandParameter="Model">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabModel}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        🧮
                    </Button>

                    <!-- Metrics -->
                    <Button Tag="Metrics" Command="{Binding NavigateCommand}" CommandParameter="Metrics">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabMetrics}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        📈
                    </Button>

                    <!-- Compare -->
                    <Button Tag="Compare" Command="{Binding NavigateCommand}" CommandParameter="Compare">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabCompare}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        📊
                    </Button>


                    <!-- Reports -->
                    <Button Tag="Reports" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabReports}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        📋
                    </Button>

                    <!-- Settings -->
                    <Button Tag="Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabSettings}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        ⚙
                    </Button>

                    <!-- About -->
                    <Button Tag="About" Command="{Binding NavigateCommand}" CommandParameter="About">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SideNavButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabAbout}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SideNavActiveTemplate}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        ℹ
                    </Button>

                    <!-- Gold bottom accent line -->
                    <Border Height="2" Background="{StaticResource GoldAccentGradient}"
                            Margin="8,12,8,0" CornerRadius="1"/>

                    <!-- Version label at bottom -->
                    <TextBlock Text="v2.2" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── CONTENT AREA ───────────────────────────────────────── -->
            <Grid Grid.Column="1">

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- HOME TAB — Flow Diagram + KPI strip                      -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabHome, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Flow diagram card -->
                    <Border Grid.Row="0" Margin="10,10,10,8"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="14"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#001400" ShadowDepth="2" BlurRadius="16" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Info bar -->
                            <Border Grid.Row="0" Padding="16,10"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="PASSENGER FLOW DIAGRAM"
                                                   Style="{StaticResource HeadingSmall}" Margin="0,0,0,6"/>
                                        <ProgressBar Value="{Binding PlaybackProgress, Mode=OneWay}"
                                                     Maximum="{Binding PlaybackTotal, Mode=OneWay}"
                                                     Style="{StaticResource SimProgressBar}"
                                                     Width="240" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock Text="T=" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SimCurrentTime, StringFormat=F1}"
                                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentGoldBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="min" Style="{StaticResource KpiLabel}"
                                                   VerticalAlignment="Center" Margin="2,0,14,0"/>
                                        <Border CornerRadius="4" Padding="7,3" Margin="0,0,6,0" Background="#0A2215">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓ " FontSize="10" Foreground="{StaticResource AccentGreenBrush}"/>
                                                <TextBlock Text="{Binding TotalCompleted}"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGreenBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="4" Padding="7,3" Margin="0,0,6,0" Background="#0A1A0A">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↑ " FontSize="10" Foreground="{StaticResource AccentGoldBrush}"/>
                                                <TextBlock Text="{Binding TotalArrived}"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGoldBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="4" Padding="7,3" Background="#200A0A">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✗ " FontSize="10" Foreground="{StaticResource AccentRedBrush}"/>
                                                <TextBlock Text="{Binding TotalLeft}"
                                                           FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentRedBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Tab control for Flow Diagram / Block Flow -->
                            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="10,8,10,10">
                                <TabItem Header="Flow Diagram">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <TextBlock Text="Flow Size" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Width="140" Minimum="0.6" Maximum="1.25"
                                                    Value="{Binding DiagramZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding DiagramZoom, StringFormat=F2}"
                                                       Style="{StaticResource KpiLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Auto" Background="Transparent">
                                            <Canvas Width="{Binding DiagramCanvasWidth}" Height="{Binding DiagramCanvasHeight}" ClipToBounds="False">
                                            <Canvas.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding EffectiveDiagramZoom}" ScaleY="{Binding EffectiveDiagramZoom}"/>
                                            </Canvas.LayoutTransform>

                                            <!-- EDGES -->
                                            <ItemsControl ItemsSource="{Binding FlowEdges}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding DataContext.DiagramCanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Height="{Binding DataContext.DiagramCanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas Width="1" Height="1" ClipToBounds="False">
                                                            <Polyline Points="{Binding Points}"
                                                                      Stroke="#1A4A20"
                                                                      StrokeThickness="1.8"
                                                                      StrokeLineJoin="Round"/>
                                                            <Polygon Points="{Binding ArrowheadPoints}"
                                                                     Fill="#22C55E" Stroke="#22C55E"
                                                                     StrokeThickness="1"/>
                                                            <TextBlock Canvas.Left="{Binding LabelLeft}"
                                                                       Canvas.Top="{Binding LabelTop}"
                                                                       Text="{Binding Label}"
                                                                       Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}"
                                                                       FontFamily="Segoe UI" FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource AccentGoldBrush}"
                                                                       Background="#060F06"
                                                                       Padding="3,1"/>
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- NODES -->
                                            <ItemsControl ItemsSource="{Binding FlowNodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding DataContext.DiagramCanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Height="{Binding DataContext.DiagramCanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                                        <Setter Property="Canvas.Top"  Value="{Binding Top}"/>
                                                        <Setter Property="Width"       Value="{Binding Width}"/>
                                                        <Setter Property="Height"      Value="{Binding Height}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding Title}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#22C55E"
                                                                                      ShadowDepth="0"
                                                                                      BlurRadius="0"
                                                                                      Opacity="0.85"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <DataTrigger.EnterActions>
                                                                        <BeginStoryboard x:Name="NodeGlowIn">
                                                                            <Storyboard>
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                    To="18" Duration="0:0:0.3">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                    From="14" To="24"
                                                                                    Duration="0:0:0.7"
                                                                                    AutoReverse="True"
                                                                                    RepeatBehavior="Forever"
                                                                                    BeginTime="0:0:0.3">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <SineEase EasingMode="EaseInOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.EnterActions>
                                                                    <DataTrigger.ExitActions>
                                                                        <StopStoryboard BeginStoryboardName="NodeGlowIn"/>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation
                                                                                    Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                    To="0" Duration="0:0:0.4">
                                                                                    <DoubleAnimation.EasingFunction>
                                                                                        <CubicEase EasingMode="EaseOut"/>
                                                                                    </DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </DataTrigger.ExitActions>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>

                                                    <!-- Diamond for decision nodes -->
                                                    <Polygon Points="{Binding DiamondPoints}"
                                                             Fill="{Binding CurrentBackground,   Converter={StaticResource HexToBrush}}"
                                                             Stroke="{Binding CurrentBorderColor, Converter={StaticResource HexToBrush}}"
                                                             StrokeThickness="1.5"
                                                             Visibility="{Binding IsDecision, Converter={StaticResource BoolToVisibility}}"/>

                                                    <!-- Rectangle for non-decision nodes -->
                                                    <Border Background="{Binding CurrentBackground,   Converter={StaticResource HexToBrush}}"
                                                            BorderBrush="{Binding CurrentBorderColor, Converter={StaticResource HexToBrush}}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="{Binding CornerRadius}"
                                                            Visibility="{Binding IsNotDecision, Converter={StaticResource BoolToVisibility}}"/>

                                                    <!-- Node title -->
                                                    <TextBlock Text="{Binding Title}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe UI" FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#E2E8F0"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Margin="6,2"
                                                               MaxWidth="{Binding Width}"/>

                                                    <!-- Active count badge -->
                                                    <Border Width="20" Height="20" CornerRadius="10"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Margin="0,-6,-6,0"
                                                            Background="{StaticResource AccentGoldBrush}"
                                                            Visibility="{Binding HasActivePassengers, Converter={StaticResource BoolToVisibility}}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasActivePassengers}" Value="True">
                                                                        <DataTrigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation
                                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                        From="0" To="1" Duration="0:0:0.22">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                    <DoubleAnimation
                                                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                        From="0" To="1" Duration="0:0:0.22">
                                                                                        <DoubleAnimation.EasingFunction>
                                                                                            <BackEase EasingMode="EaseOut" Amplitude="0.4"/>
                                                                                        </DoubleAnimation.EasingFunction>
                                                                                    </DoubleAnimation>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </DataTrigger.EnterActions>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="{StaticResource AccentGold}"
                                                                              ShadowDepth="0" BlurRadius="6" Opacity="0.7"/>
                                                        </Border.Effect>
                                                        <TextBlock Text="{Binding ActiveCountLabel}"
                                                                   FontSize="9" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="#0A1A0A"/>
                                                    </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- PASSENGER TOKENS -->
                                            <ItemsControl ItemsSource="{Binding PassengerTokens}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding DataContext.DiagramCanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                Height="{Binding DataContext.DiagramCanvasHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                                        <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="18" Height="18" ToolTip="{Binding Label}">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0" ScaleY="0"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                From="0" To="1" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation
                                                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                From="0" To="1" Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Ellipse Fill="{Binding TokenColor, Converter={StaticResource HexToBrush}}"
                                                             Stroke="White" StrokeThickness="0.8"
                                                             Opacity="0.92"/>
                                                    <TextBlock Text="{Binding Label}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe UI" FontSize="7"
                                                               FontWeight="Bold" Foreground="White"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            </Canvas>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Block Flow">
                                    <Grid Margin="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                            <TextBlock Text="Block Size" Style="{StaticResource KpiLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Width="150" Minimum="0.7" Maximum="1.7"
                                                    Value="{Binding BlockScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="{Binding EffectiveBlockScale, StringFormat=F2}"
                                                       Style="{StaticResource KpiLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding BlockFlowNodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{Binding DataContext.EffectiveBlockScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Multiply}, ConverterParameter=240}"
                                                                MinHeight="{Binding DataContext.EffectiveBlockScale, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Multiply}, ConverterParameter=128}"
                                                                Margin="0,0,12,12" Padding="10"
                                                                Background="{Binding CurrentBackground, Converter={StaticResource HexToBrush}}"
                                                                BorderBrush="{Binding CurrentBorderColor, Converter={StaticResource HexToBrush}}"
                                                                BorderThickness="1.3" CornerRadius="8">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingSmall}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding ActiveCountLabel, StringFormat=Active: {0}}"
                                                                           Style="{StaticResource KpiLabel}" Margin="0,2,0,6"
                                                                           Visibility="{Binding HasActivePassengers, Converter={StaticResource BoolToVisibility}}"/>
                                                                <TextBlock Text="No active customers"
                                                                           Style="{StaticResource KpiLabel}" Margin="0,2,0,4"
                                                                           Visibility="{Binding HasActivePassengers, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                                <ItemsControl ItemsSource="{Binding ActivePassengers}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#0B1A0C" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                    CornerRadius="5" Margin="0,0,0,4" Padding="6,3">
                                                                                <TextBlock Text="{Binding}" FontFamily="Segoe UI" FontSize="11"
                                                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>

                    <!-- Quick KPI strip at bottom of Home tab -->
                    <Border Grid.Row="1" Margin="10,0,10,8"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12" Padding="16,10"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- ρ -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="UTILIZATION ρ" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiRho, Converter={StaticResource DoubleToFixed}}"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{Binding KpiRho, Converter={StaticResource UtilToBrush}}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Wq -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="AVG WAIT Wq" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiWq, Converter={StaticResource DoubleToFixed}}"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- W -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="SYS TIME W" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiW, Converter={StaticResource DoubleToFixed}}"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Lq -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="QUEUE LEN Lq" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding KpiLq, Converter={StaticResource DoubleToFixed}}"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGoldBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Served -->
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <TextBlock Text="SERVED" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCompleted}"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- Throughput -->
                            <StackPanel Grid.Column="5" HorizontalAlignment="Center">
                                <TextBlock Text="THROUGHPUT" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Throughput, Converter={StaticResource DoubleToFixed}}"
                                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>

                    <!-- Right Sidebar for Simulation Parameters & Controls -->
                    <Border Grid.Column="1" Margin="5,10,10,8"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="14" Padding="16"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="SIMULATION CONTROLS" Style="{StaticResource HeadingSmall}" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <Button Content="▶  Simulate" Style="{StaticResource ButtonStart}" Command="{Binding StartCommand}" Margin="0,0,6,6"/>
                                    <Button Content="⏸  Pause"   Style="{StaticResource ButtonPause}" Command="{Binding PauseCommand}" Margin="0,0,6,6"/>
                                    <Button Content="▶  Resume"  Style="{StaticResource ButtonResume}" Command="{Binding ResumeCommand}" Margin="0,0,6,6"/>
                                    <Button Content="⏭  Next Step"  Style="{StaticResource ButtonReset}" Command="{Binding StepCommand}" Margin="0,0,6,6"/>
                                    <Button Content="⏹  Stop"    Style="{StaticResource ButtonStop}" Command="{Binding StopCommand}" Margin="0,0,6,6"/>
                                    <Button Content="↺  Reset"   Style="{StaticResource ButtonReset}" Command="{Binding ResetCommand}" Margin="0,0,0,6"/>
                                </WrapPanel>
                                
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Speed:" Style="{StaticResource ParamLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider Grid.Column="1" Minimum="0.1" Maximum="3" Value="{Binding PlaybackSpeed}" SmallChange="0.1" LargeChange="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding PlaybackSpeed, StringFormat={}{0:F2}x}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                </Grid>

                                <Separator Style="{StaticResource HSep}"/>
                                <TextBlock Text="QUEUE MODEL" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model Type" Style="{StaticResource ParamLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding QueueModels}" SelectedItem="{Binding SelectedQueueModel, Mode=TwoWay}" Style="{StaticResource SpeedComboBox}"/>
                                </Grid>

                                <Separator Style="{StaticResource HSep}"/>
                                <TextBlock Text="PARAMETERS" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arrival Rate (λ)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ArrivalRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Service Rate (μ)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ServiceRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Duration (mins)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8"
                                      Visibility="{Binding IsMM1, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Grid.Column="0" Text="Service CV (Cs)" Style="{StaticResource ParamLabel}"/>
                                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="Variability of service time"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ServiceCv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8"
                                      Visibility="{Binding IsGG1, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Grid.Column="0" Text="Arrival CV (Ca)" Style="{StaticResource ParamLabel}"/>
                                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="Variability of inter-arrival"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ArrivalCv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <!-- Validation error -->
                                <Border CornerRadius="7" Padding="10,7" Margin="0,4,0,0"
                                        Background="#2D1010" BorderThickness="1" BorderBrush="#5A1B1B"
                                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ValidationError}" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- MODEL TAB — Column-wise M/M/1 Simulation Table           -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabModel, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar for Simulation Parameters & Controls -->
                    <Border Grid.Column="0" Margin="10,10,5,8"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="14" Padding="16"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="QUEUE MODEL" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model Type" Style="{StaticResource ParamLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding QueueModels}" SelectedItem="{Binding SelectedQueueModel, Mode=TwoWay}" Style="{StaticResource SpeedComboBox}"/>
                                </Grid>

                                <Separator Style="{StaticResource HSep}"/>
                                <TextBlock Text="PARAMETERS" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arrival Rate (λ)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ArrivalRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Service Rate (μ)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding ServiceRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Duration (mins)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Grid Margin="0,0,0,8"
                                      Visibility="{Binding IsMM1, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Service CV (Cs)" Style="{StaticResource ParamLabel}"/>
                                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="Variability of service time"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ServiceCv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8"
                                      Visibility="{Binding IsGG1, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Arrival CV (Ca)" Style="{StaticResource ParamLabel}"/>
                                        <TextBlock FontSize="9" Foreground="{StaticResource TextMutedBrush}" Text="Variability of inter-arrival"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Text="{Binding ArrivalCv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Separator Style="{StaticResource HSep}"/>
                                <TextBlock Text="MODEL ANALYTICS" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="13" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                    <Run Text="λ ="/>
                                    <Run Text="{Binding ArrivalRate, StringFormat=F2, Mode=OneWay}" Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold"/>
                                    <Run Text="  μ ="/>
                                    <Run Text="{Binding ServiceRate, StringFormat=F2, Mode=OneWay}" Foreground="{StaticResource AccentGreenBrush}" FontWeight="Bold"/>
                                    <Run Text="  ρ ="/>
                                    <Run Text="{Binding KpiRho, StringFormat=F4, Mode=OneWay}" Foreground="{Binding KpiRho, Converter={StaticResource UtilToBrush}}" FontWeight="Bold"/>
                                </TextBlock>

                                <!-- Validation error -->
                                <Border CornerRadius="7" Padding="10,7" Margin="0,12,0,0"
                                        Background="#2D1010" BorderThickness="1" BorderBrush="#5A1B1B"
                                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ValidationError}" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource AccentRedBrush}" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Model tab header -->
                    <Border Grid.Row="0" Margin="5,10,10,6"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12" Padding="18,12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding QueueModelHeaderText, Mode=OneWay, StringFormat='{} {0} SIMULATION TABLE'}" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock FontFamily="Segoe UI" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Detailed event sequence and passenger processing breakdown."/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Run a simulation to populate the table" Style="{StaticResource KpiLabel}"
                                           Visibility="{Binding IsTabModel, Converter={StaticResource BoolToVisibility}}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table -->
                    <Border Grid.Row="1" Margin="10,0,10,6"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Column header row -->
                                <Border Background="#F8FAF8" Padding="0,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="68"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"  Text="S.No"           Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="1"  Text="Cum. Prob"       Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="2"  Text="Cum. Prob Lookup" Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="3"  Text="Min b/w Arr."    Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="4"  Text="Rand Inter-Arr." Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="5"  Text="Poisson Arr."    Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="6"  Text="Rand Service"    Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="7"  Text="Exp. Service"    Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="8"  Text="Arrival Time"    Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="9"  Text="Start Time"      Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="10" Text="End Time"        Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="11" Text="Turnaround"      Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                        <TextBlock Grid.Column="12" Text="Wait | Response" Style="{StaticResource TableHeaderCell}" Padding="4,0"/>
                                    </Grid>
                                </Border>

                                <!-- Data rows -->
                                <ItemsControl ItemsSource="{Binding ModellingRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBackground}"
                                                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                                                    Padding="0,5">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#142A16"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="82"/>
                                                        <ColumnDefinition Width="68"/>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="68"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="68"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"  Text="{Binding SNo}"                               Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGoldBrush}"/>
                                                    <TextBlock Grid.Column="1"  Text="{Binding CumProb,       StringFormat=F5}"    Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="2"  Text="{Binding CumProbLookup, StringFormat=F5}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="3"  Text="{Binding MinsBetweenArrivals}"               Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="4"  Text="{Binding RandomInterArrival, StringFormat=F4}" Style="{StaticResource TableDataCell}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="5"  Text="{Binding PoissonArrival}"                    Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    <TextBlock Grid.Column="6"  Text="{Binding RandomService, StringFormat=F4}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="7"  Text="{Binding ExpService,    StringFormat=F2}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGoldBrush}"/>
                                                    <TextBlock Grid.Column="8"  Text="{Binding ArrivalTime,   StringFormat=F2}"    Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="9"  Text="{Binding StartTime,     StringFormat=F2}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    <TextBlock Grid.Column="10" Text="{Binding EndTime,       StringFormat=F2}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentRedBrush}"/>
                                                    <TextBlock Grid.Column="11" Text="{Binding TurnaroundTime,StringFormat=F2}"    Style="{StaticResource TableDataCell}"/>
                                                    <StackPanel Grid.Column="12" Orientation="Vertical" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding WaitTime,     StringFormat=W:{0:F2}}"  Style="{StaticResource TableDataCell}" FontSize="10" Foreground="#EF4444"/>
                                                        <TextBlock Text="{Binding ResponseTime, StringFormat=R:{0:F2}}"  Style="{StaticResource TableDataCell}" FontSize="10" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <Border Padding="40,30"
                                        Visibility="{Binding ModellingRows.Count, Converter={StaticResource IntToInverseVisibility}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="🧮" FontSize="48" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No simulation data yet" Style="{StaticResource HeadingMedium}"
                                                   HorizontalAlignment="Center" Margin="0,12,0,4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Run a simulation from the Settings tab or use the button above"
                                                   Style="{StaticResource KpiLabel}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Summary footer -->
                    <Border Grid.Row="2" Margin="10,0,10,8"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="10" Padding="18,10"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="AVG INTER-ARRIVAL" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ModellingAvgInterArrival, StringFormat={}{0:F3} min}"
                                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGoldBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="AVG WAIT TIME" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ModellingAvgWait, StringFormat={}{0:F3} min}"
                                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentRedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
<StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="AVG TURNAROUND" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ModellingAvgTurnaround, StringFormat={}{0:F3} min}"
                                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                <TextBlock Text="AVG RESPONSE" Style="{StaticResource HeadingSmall}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding ModellingAvgResponse, StringFormat={}{0:F3} min}"
                                           FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- METRICS TAB — Individual Run Charts                      -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabMetrics, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Margin="10,10,10,6"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12" Padding="18,12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel>
                            <TextBlock Text="INDIVIDUAL RUN METRICS" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="Charts displaying the distribution for the latest simulation run"
                                       Style="{StaticResource KpiLabel}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 1: Wait Time and Turnaround Time Charts -->
                    <Grid Grid.Row="1" Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Wait Time Chart -->
                        <Border Grid.Column="0" Margin="0,0,6,0"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="CURRENT RUN WAIT TIMES (Wq)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="minutes per passenger" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- LiveCharts Canvas -->
                                <Border Grid.Row="1" Background="#040D04" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <lvc:CartesianChart Series="{Binding CurrentRunWaitTimes}"
                                                        Margin="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Turnaround Time Chart -->
                        <Border Grid.Column="1" Margin="6,0,0,0"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="CURRENT RUN TURNAROUND TIMES (W)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="minutes per passenger" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- LiveCharts Canvas -->
                                <Border Grid.Row="1" Background="#040D04" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <lvc:CartesianChart Series="{Binding CurrentRunTurnaroundTimes}"
                                                        Margin="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: KPI summary panel -->
                    <Grid Grid.Row="2" Margin="10,0,10,8">
                        <Border Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="CURRENT RUN KPIs" Style="{StaticResource HeadingSmall}" Margin="0,0,0,14"/>
                                <UniformGrid Grid.Row="1" Columns="4" Rows="1">
                                    <!-- ρ -->
                                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="24"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Utilisation (ρ)" Style="{StaticResource KpiLabel}"/>
                                                    <TextBlock Text="λ / μ" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KpiRho, Converter={StaticResource DoubleToFixed}}"
                                                           FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                                           Foreground="{Binding KpiRho, Converter={StaticResource UtilToBrush}}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <lvc:CartesianChart Grid.Row="1" Series="{Binding KpiRhoSeries}" XAxes="{Binding SparklineXAxes}" YAxes="{Binding SparklineYAxes}" Margin="0,8,0,0" TooltipPosition="Hidden"/>
                                        </Grid>
                                    </Border>
                                    <!-- Wq -->
                                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="24"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Avg Queue Wait (Wq)" Style="{StaticResource KpiLabel}"/>
                                                    <TextBlock Text="minutes" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KpiWq, Converter={StaticResource DoubleToFixed}}"
                                                           FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGoldBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <lvc:CartesianChart Grid.Row="1" Series="{Binding KpiWqSeries}" XAxes="{Binding SparklineXAxes}" YAxes="{Binding SparklineYAxes}" Margin="0,8,0,0" TooltipPosition="Hidden"/>
                                        </Grid>
                                    </Border>
                                    <!-- W -->
                                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="24"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Avg System Time (W)" Style="{StaticResource KpiLabel}"/>
                                                    <TextBlock Text="minutes" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KpiW, Converter={StaticResource DoubleToFixed}}"
                                                           FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <lvc:CartesianChart Grid.Row="1" Series="{Binding KpiWSeries}" XAxes="{Binding SparklineXAxes}" YAxes="{Binding SparklineYAxes}" Margin="0,8,0,0" TooltipPosition="Hidden"/>
                                        </Grid>
                                    </Border>
                                    <!-- L -->
                                    <Border Style="{StaticResource KpiCard}" Margin="0,0,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="24"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Avg in System (L)" Style="{StaticResource KpiLabel}"/>
                                                    <TextBlock Text="passengers" FontSize="9" Foreground="{StaticResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding KpiL, Converter={StaticResource DoubleToFixed}}"
                                                           FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentGreenBrush}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <lvc:CartesianChart Grid.Row="1" Series="{Binding KpiLSeries}" XAxes="{Binding SparklineXAxes}" YAxes="{Binding SparklineYAxes}" Margin="0,8,0,0" TooltipPosition="Hidden"/>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 3: Gantt Chart -->
                    <Grid Grid.Row="3" Margin="10,0,10,8">
                        <Border Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                    <TextBlock Text="GANTT CHART (ARRIVAL, WAIT, SERVICE)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="Timeline of first and last few passengers" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding GanttItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8" Height="24">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    
                                                    <StackPanel Orientation="Horizontal" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PassengerId, StringFormat='Pax #{0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontFamily="Segoe UI" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    
                                                    <Canvas Margin="100,0,0,0">
                                                        <!-- Arrival Marker -->
                                                        <Ellipse Width="6" Height="6" Fill="#4B5563" Canvas.Left="{Binding ArrivalTime, Converter={StaticResource Multiply}, ConverterParameter=10}" Canvas.Top="9"/>
                                                        
                                                        <!-- Wait Bar -->
                                                        <Border Height="12" Canvas.Left="{Binding WaitStart, Converter={StaticResource Multiply}, ConverterParameter=10}" Canvas.Top="6" 
                                                                Width="{Binding WaitDuration, Converter={StaticResource Multiply}, ConverterParameter=10}" 
                                                                Background="#F59E0B" Opacity="0.7" CornerRadius="4,0,0,4"/>
                                                        
                                                        <!-- Service Bar -->
                                                        <Border Height="12" Canvas.Left="{Binding ServiceStart, Converter={StaticResource Multiply}, ConverterParameter=10}" Canvas.Top="6" 
                                                                Width="{Binding SvcDuration, Converter={StaticResource Multiply}, ConverterParameter=10}" 
                                                                Background="#22C55E" CornerRadius="0,4,4,0"/>
                                                    </Canvas>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                
                                <!-- Ellipsis Marker for middle skipped items -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding GanttItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="..." Margin="35,0,0,8" Foreground="{StaticResource TextMutedBrush}" FontSize="18" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEllipsis}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- COMPARE TAB — Cross-model Comparisons                    -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabCompare, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Margin="10,10,10,6"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12" Padding="18,12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel>
                            <TextBlock Text="CROSS-MODEL COMPARISONS" Style="{StaticResource HeadingSmall}"/>
                            <TextBlock Text="Analyze performance trends and compare Queue Models"
                                       Style="{StaticResource KpiLabel}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 1: Model Comparison (Bar Charts) -->
                    <Grid Grid.Row="1" Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Compare Wq -->
                        <Border Grid.Column="0" Margin="0,0,6,0"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="MODEL WAIT TIME COMPARISON (Wq)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="Latest run for each model" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="#040D04" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <lvc:CartesianChart Series="{Binding ModelCompareWqSeries}" XAxes="{Binding ModelCompareXAxes}"
                                                        Margin="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Compare W -->
                        <Border Grid.Column="1" Margin="6,0,0,0"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="MODEL SYSTEM TIME COMPARISON (W)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="Latest run for each model" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="#040D04" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <lvc:CartesianChart Series="{Binding ModelCompareWSeries}" XAxes="{Binding ModelCompareXAxes}"
                                                        Margin="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 2: Trend Over Time (Line Charts) -->
                    <Grid Grid.Row="2" Margin="10,0,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Wait Time Trend -->
                        <Border Grid.Column="0" Margin="0,0,6,0"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="WAIT TIME TREND (Wq)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="Across last 10 simulation runs" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="#040D04" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <lvc:CartesianChart Series="{Binding WaitTimeTrend}" XAxes="{Binding XAxes}"
                                                        Margin="10"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Queue Length Trend -->
                        <Border Grid.Column="1" Margin="6,0,0,0"
                                Background="{StaticResource CardGradient}"
                                CornerRadius="12" Padding="16"
                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="QUEUE LENGTH TREND (Lq)" Style="{StaticResource HeadingSmall}"/>
                                    <TextBlock Text="Across last 10 simulation runs" Style="{StaticResource KpiLabel}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="#040D04" CornerRadius="6"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                    <lvc:CartesianChart Series="{Binding QueueLengthTrend}" XAxes="{Binding XAxes}"
                                                        Margin="10"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- REPORTS TAB — Run History Table                          -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabReports, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Margin="10,10,10,6"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12" Padding="18,12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SIMULATION RUN REPORTS" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Margin="0,4,0,0">
                                    <Run Text="{Binding RunHistory.Count, Mode=OneWay}"/>
                                    <Run Text="runs recorded this session"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"
                                       Text="Newest first · Current session only"/>
                        </Grid>
                    </Border>

                    <!-- Reports table -->
                    <Border Grid.Row="1" Margin="10,0,10,10"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Table header -->
                                <Border Background="#F8FAF8" Padding="0,8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"  Text="Run"          Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="1"  Text="Model"        Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="2"  Text="λ"            Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="3"  Text="μ"            Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="4"  Text="ρ Util."      Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="5"  Text="Lq Avg Q"     Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="6"  Text="Wq Wait"      Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="7"  Text="W Sys"        Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="8"  Text="L in Sys"     Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="9"  Text="Served"       Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="10" Text="Left"         Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="11" Text="Throughput"   Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="12" Text="Completion"   Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="13" Text="Time"         Style="{StaticResource TableHeaderCell}"/>
                                    </Grid>
                                </Border>

                                <!-- Rows -->
                                <ItemsControl ItemsSource="{Binding RunHistory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,7"
                                                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="58"/>
                                                        <ColumnDefinition Width="58"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="64"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"  Text="{Binding RunNumber, StringFormat=#{0}}"
                                                               Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="1"  Text="{Binding ModelName}"
                                                               Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    <TextBlock Grid.Column="2"  Text="{Binding Lambda,     StringFormat=F2}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="3"  Text="{Binding Mu,         StringFormat=F2}" Style="{StaticResource TableDataCell}"/>
                                                    <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            CornerRadius="4" Padding="6,2"
                                                            Background="{Binding RhoColor, Converter={StaticResource HexToBrush}, ConverterParameter=30}"
                                                            BorderBrush="{Binding RhoColor, Converter={StaticResource HexToBrush}, ConverterParameter=80}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding RhoFormatted}"
                                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{Binding RhoColor, Converter={StaticResource HexToBrush}}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="5"  Text="{Binding LqFormatted}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="6"  Text="{Binding WqFormatted}" Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGoldBrush}"/>
                                                    <TextBlock Grid.Column="7"  Text="{Binding WFormatted}"  Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="8"  Text="{Binding LFormatted}"  Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="9"  Text="{Binding TotalServed}"  Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    <TextBlock Grid.Column="10" Text="{Binding TotalLeft}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentRedBrush}"/>
                                                    <TextBlock Grid.Column="11" Text="{Binding ThroughputFormatted}" Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    <TextBlock Grid.Column="12" Text="{Binding CompletionFormatted}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="13" Text="{Binding Timestamp}"    Style="{StaticResource TableDataCell}" Foreground="{StaticResource TextMutedBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <Border Padding="40,40"
                                        Visibility="{Binding RunHistory.Count, Converter={StaticResource IntToInverseVisibility}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="📋" FontSize="56" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No runs yet" Style="{StaticResource HeadingMedium}"
                                                   HorizontalAlignment="Center" Margin="0,14,0,4"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Complete a simulation run and it will appear here"
                                                   Style="{StaticResource KpiLabel}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    
                    <!-- Customer Records Header -->
                    <Border Grid.Row="2" Margin="10,0,10,6"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12" Padding="18,12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CUSTOMER RECORDS (CURRENT RUN)" Style="{StaticResource HeadingSmall}"/>
                                <TextBlock Style="{StaticResource KpiLabel}" Margin="0,4,0,0">
                                    <Run Text="{Binding CompletedPassengers.Count, Mode=OneWay}"/>
                                    <Run Text="passengers completed"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource KpiLabel}" VerticalAlignment="Center"
                                       Text="Details for each passenger"/>
                        </Grid>
                    </Border>

                    <!-- Customer Records Table -->
                    <Border Grid.Row="3" Margin="10,0,10,10"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="12"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Table header -->
                                <Border Background="#F8FAF8" Padding="0,8"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,2">
                                    <Grid Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Customer"     Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="1" Text="Arrival Time" Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="2" Text="Service Start" Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="3" Text="Service End"  Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="4" Text="Wait Time"    Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="5" Text="Turnaround"   Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="6" Text="Status"       Style="{StaticResource TableHeaderCell}"/>
                                        <TextBlock Grid.Column="7" Text="Action"       Style="{StaticResource TableHeaderCell}"/>
                                    </Grid>
                                </Border>

                                <!-- Rows -->
                                <ItemsControl ItemsSource="{Binding CompletedPassengers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,7" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F0FDF4"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat=CUS-{0:D4}}" Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ArrivalTime, StringFormat=F2}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding ServiceStartTime, StringFormat=F2}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding ServiceEndTime, StringFormat=F2}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding WaitTime, StringFormat={}{0:F2} min}" Style="{StaticResource TableDataCell}" Foreground="#EF4444"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding TurnaroundTime, StringFormat={}{0:F2} min}" Style="{StaticResource TableDataCell}"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Status}" Style="{StaticResource TableDataCell}" Foreground="{StaticResource AccentGreenBrush}"/>
                                                    <Button Grid.Column="7" Content="View" 
                                                            Command="{Binding DataContext.ViewCustomerCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"
                                                            Background="#16A34A" Foreground="White" BorderThickness="0"
                                                            Padding="8,2" Cursor="Hand"
                                                            HorizontalAlignment="Left" FontSize="11" FontWeight="SemiBold">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty state -->
                                <Border Padding="40,40" Visibility="{Binding CompletedPassengers.Count, Converter={StaticResource IntToInverseVisibility}}">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="👥" FontSize="56" HorizontalAlignment="Center"/>
                                        <TextBlock Text="No customer data" Style="{StaticResource HeadingMedium}" HorizontalAlignment="Center" Margin="0,14,0,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="Run a simulation to view customer records" Style="{StaticResource KpiLabel}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- SETTINGS TAB — All simulation parameters + controls      -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabSettings, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Column 1: Queue model + core params -->
                    <Border Grid.Column="0" Margin="10,10,5,10"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="14" Padding="18"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="QUEUE MODEL" Style="{StaticResource HeadingSmall}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Model Type" Style="{StaticResource ParamLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding QueueModels}"
                                              SelectedItem="{Binding SelectedQueueModel, Mode=TwoWay}"
                                              Style="{StaticResource SpeedComboBox}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10"
                                      Visibility="{Binding IsMM1, Converter={StaticResource InverseBoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Service CV (Cs)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ServiceCv, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}"
                                             IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Grid Margin="0,0,0,12"
                                      Visibility="{Binding IsGG1, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arrival CV (Ca)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ArrivalCv, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}"
                                             IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Separator Style="{StaticResource HSep}"/>
                                <TextBlock Text="SIMULATION PARAMETERS" Style="{StaticResource HeadingSmall}" Margin="0,6,0,12"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Arrival Rate λ (pax/min)" Style="{StaticResource ParamLabel}" TextWrapping="Wrap"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ArrivalRate, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}"
                                             IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Service Rate μ (pax/min)" Style="{StaticResource ParamLabel}" TextWrapping="Wrap"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ServiceRate, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}"
                                             IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Duration (minutes)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}"
                                             IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <!-- Stability hint -->
                                <Border CornerRadius="7" Padding="10,7" Margin="0,4,0,14"
                                        BorderThickness="1"
                                        BorderBrush="{Binding KpiRho, Converter={StaticResource UtilToBrush}}"
                                        Background="#040D04">
                                    <TextBlock Text="{Binding StabilityHint}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{Binding KpiRho, Converter={StaticResource UtilToBrush}}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Validation error -->
                                <Border CornerRadius="7" Padding="10,7" Margin="0,0,0,10"
                                        Background="#2D1010" BorderThickness="1" BorderBrush="#5A1B1B"
                                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding ValidationError}"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Foreground="{StaticResource AccentRedBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Column 2: Flow probabilities + trace -->
                    <Border Grid.Column="1" Margin="5,10,5,10"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="14" Padding="18"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="FLOW PROBABILITIES" Style="{StaticResource HeadingSmall}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ticket Required" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding TicketRequiredProb, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Buy Ticket (Inquiry)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding BuyTicketProb, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Use Card (vs Cash)" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding CardUsageProb, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Card Valid" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding CardValidProb, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Account Valid" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding AccountValidProb, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sufficient Funds" Style="{StaticResource ParamLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding SufficientFundsProb, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ParamTextBox}" IsEnabled="{Binding CanEditParams}"/>
                                </Grid>

                                <Separator Style="{StaticResource HSep}"/>
                                <TextBlock Text="TRACE MODE" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                                <CheckBox Style="{StaticResource ToggleCheck}"
                                          IsChecked="{Binding TraceModeEnabled}"
                                          Content="Show step trace (first 50)"
                                          Margin="0,0,0,12"
                                          IsEnabled="{Binding CanEditParams}"/>

                                <Border Height="120" Background="#030803" CornerRadius="7" Padding="8"
                                        BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                                        Visibility="{Binding TraceModeEnabled, Converter={StaticResource BoolToVisibility}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding PassengerLog}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" FontSize="9"
                                                               FontFamily="Consolas"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" Margin="0,1"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Column 3: Controls + playback speed -->
                    <Border Grid.Column="2" Margin="5,10,10,10"
                            Background="{StaticResource CardGradient}"
                            CornerRadius="14" Padding="18"
                            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                        <StackPanel>
                            <TextBlock Text="SIMULATION CONTROLS" Style="{StaticResource HeadingSmall}" Margin="0,0,0,14"/>

                            <WrapPanel>
                                <Button Content="▶  Simulate" Style="{StaticResource ButtonStart}"
                                        Command="{Binding StartCommand}" Margin="0,0,6,6"/>
                                <Button Content="⏸  Pause"   Style="{StaticResource ButtonPause}"
                                        Command="{Binding PauseCommand}" Margin="0,0,6,6"/>
                                <Button Content="▶  Resume"  Style="{StaticResource ButtonResume}"
                                        Command="{Binding ResumeCommand}" Margin="0,0,6,6"/>
                                <Button Content="⏭  Next Step"  Style="{StaticResource ButtonReset}"
                                    Command="{Binding StepCommand}" Margin="0,0,6,6"/>
                                <Button Content="⏹  Stop"    Style="{StaticResource ButtonStop}"
                                        Command="{Binding StopCommand}" Margin="0,0,6,6"/>
                                <Button Content="↺  Reset"   Style="{StaticResource ButtonReset}"
                                        Command="{Binding ResetCommand}" Margin="0,0,0,6"/>
                            </WrapPanel>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Text="PLAYBACK SPEED" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                            <ComboBox ItemsSource="{Binding SpeedOptions}"
                                      SelectedItem="{Binding SelectedSpeed}"
                                      Style="{StaticResource SpeedComboBox}"
                                      HorizontalAlignment="Left"/>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Text="QUICK NAVIGATE" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                            <UniformGrid Columns="2" Rows="3">
                                <Button Content="🏠 Home" Style="{StaticResource ButtonReset}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Home" Margin="0,0,6,6"/>
                                <Button Content="🧮 Model" Style="{StaticResource ButtonReset}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Model" Margin="0,0,0,6"/>
                                <Button Content="📈 Metrics" Style="{StaticResource ButtonReset}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Metrics" Margin="0,0,6,6"/>
                                <Button Content="📊 Compare" Style="{StaticResource ButtonReset}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Compare" Margin="0,0,0,6"/>
                                <Button Content="📋 Reports" Style="{StaticResource ButtonReset}"
                                        Command="{Binding NavigateCommand}" CommandParameter="Reports" Margin="0,0,6,0"/>
                            </UniformGrid>

                            <Separator Style="{StaticResource HSep}"/>
                            <TextBlock Text="STATUS" Style="{StaticResource HeadingSmall}" Margin="0,6,0,10"/>
                            <Border CornerRadius="8" Padding="12,10"
                                    Background="#030803" BorderThickness="1"
                                    BorderBrush="{StaticResource BorderBrush}">
                                <TextBlock Text="{Binding PlainSummary}"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           LineHeight="17"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ════════════════════════════════════════════════════════ -->
                <!-- ABOUT TAB                                                -->
                <!-- ════════════════════════════════════════════════════════ -->
                <Grid Visibility="{Binding IsTabAbout, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30" MaxWidth="760" HorizontalAlignment="Center">
                            <!-- Logo + title -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,28">
                                <Border Width="80" Height="80" CornerRadius="16" Background="White" Padding="6" Margin="0,0,20,0">
                                    <Image Source="/Assets/karachi-logo.png" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Karachi Railway System"
                                               Style="{StaticResource HeadingLarge}" FontSize="26"/>
                                    <TextBlock Text="Queue Simulation Platform  ·  v2.2"
                                               Style="{StaticResource BodyText}" Margin="0,6,0,0" Opacity="0.8"/>
                                    <Border Height="3" CornerRadius="2" Margin="0,10,0,0" Width="200" HorizontalAlignment="Left"
                                            Background="{StaticResource GoldAccentGradient}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Description card -->
                            <Border Background="{StaticResource CardGradient}"
                                    CornerRadius="14" Padding="24,20" Margin="0,0,0,16"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="ABOUT THIS APPLICATION" Style="{StaticResource HeadingSmall}" Margin="0,0,0,12"/>
                                    <TextBlock Style="{StaticResource BodyText}">
                                        This application simulates passenger flow through a railway station using discrete-event 
                                        simulation with queueing theory models. Passengers arrive according to a Poisson process 
                                        and are served by exponential or general service time distributions.
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0">
                                        The flow diagram shows each decision point a passenger encounters — from ticket purchase 
                                        to boarding — animated in real time as the simulation plays back.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Queue models grid -->
                            <Border Background="{StaticResource CardGradient}"
                                    CornerRadius="14" Padding="24,20" Margin="0,0,0,16"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="SUPPORTED QUEUE MODELS" Style="{StaticResource HeadingSmall}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="10" Padding="16,14" Margin="0,0,8,0"
                                                BorderThickness="1" BorderBrush="#86EFAC">
                                            <StackPanel>
                                                <TextBlock Text="M/M/1" Style="{StaticResource HeadingLarge}"
                                                           Foreground="{StaticResource AccentGreenBrush}"/>
                                                <TextBlock Text="Poisson arrivals + Exponential service"
                                                           Style="{StaticResource KpiLabel}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#FEFCE8" CornerRadius="10" Padding="16,14" Margin="4,0"
                                                BorderThickness="1" BorderBrush="#FDE047">
                                            <StackPanel>
                                                <TextBlock Text="M/G/1" Style="{StaticResource HeadingLarge}"
                                                           Foreground="{StaticResource AccentGoldBrush}"/>
                                                <TextBlock Text="Poisson arrivals + General service"
                                                           Style="{StaticResource KpiLabel}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="#F5F3FF" CornerRadius="10" Padding="16,14" Margin="8,0,0,0"
                                                BorderThickness="1" BorderBrush="#C4B5FD">
                                            <StackPanel>
                                                <TextBlock Text="G/G/1" Style="{StaticResource HeadingLarge}"
                                                           Foreground="#A78BFA"/>
                                                <TextBlock Text="General arrivals + General service"
                                                           Style="{StaticResource KpiLabel}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Terminologies -->
                            <Border Background="{StaticResource CardGradient}"
                                    CornerRadius="14" Padding="24,20" Margin="0,0,0,16"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="QUEUEING THEORY TERMINOLOGIES &amp; FORMULAE" Style="{StaticResource HeadingSmall}" Margin="0,0,0,14"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="λ (Lambda) — Arrival Rate" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                                            <TextBlock Text="The average number of passengers arriving per minute." Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="μ (Mu) — Service Rate" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                                            <TextBlock Text="The average number of passengers served per minute by a single server." Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="ρ (Rho) — Utilization (λ / μ)" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Must be less than 1 for a stable queue." Style="{StaticResource BodyText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Wq — Avg Queue Wait" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Average time a passenger spends waiting in the queue before service starts." Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="W — Avg System Wait" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                                            <TextBlock Text="Average total time a passenger spends in the system (Wq + 1/μ)." Style="{StaticResource BodyText}" Margin="0,0,0,12"/>
                                            
                                            <TextBlock Text="L / Lq — Lengths" Style="{StaticResource HeadingMedium}" Margin="0,0,0,4"/>
                                            <TextBlock Text="L is average passengers in system. Lq is average passengers in queue (Lq = λ × Wq)." Style="{StaticResource BodyText}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Credits -->
                            <Border Background="{StaticResource CardGradient}"
                                    CornerRadius="14" Padding="24,20"
                                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                <StackPanel>
                                    <TextBlock Text="DEVELOPED BY" Style="{StaticResource HeadingSmall}" Margin="0,0,0,12"/>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Rizwan" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Asad" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Anabia" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Ammara" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Maryam" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Momina" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Hasnain" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <TextBlock Text="Ahmed Hussain" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </WrapPanel>
                                    <Border Height="2" CornerRadius="1" Background="{StaticResource GoldAccentGradient}"
                                            HorizontalAlignment="Left" Width="120" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
        </StackPanel>
    </ScrollViewer>
</Grid>

</Grid>
</Grid>

<!-- ══ STATUS BAR ═════════════════════════════════════════════════ -->
<Border Grid.Row="2"
        Background="{StaticResource TitleBarGradient}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="0,1,0,0">
    <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="KRS" Style="{StaticResource KpiLabel}"
                   VerticalAlignment="Center" Foreground="{StaticResource AccentGoldBrush}" FontWeight="Bold"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding PlainSummary}"
                   Style="{StaticResource KpiLabel}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Opacity="0.7"/>
        <TextBlock Grid.Column="2"
                   Text="Karachi Railway System v2.2  ·  Green Theme"
                   Style="{StaticResource KpiLabel}"
                   VerticalAlignment="Center"
                   Opacity="0.5"/>
    </Grid>
</Border>

<!-- ══ CUSTOMER DETAILS MODAL ═════════════════════════════════════ -->
<Grid x:Name="CustomerModal" Grid.RowSpan="3" Panel.ZIndex="998"
      Background="#99000000"
      Visibility="{Binding IsCustomerModalOpen, Converter={StaticResource BoolToVisibility}}">
    <!-- Click out to close -->
    <Button Background="Transparent" BorderThickness="0" Command="{Binding CloseCustomerModalCommand}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="Transparent"/>
            </ControlTemplate>
        </Button.Template>
    </Button>
    
    <Border Width="400" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="White" CornerRadius="16" Padding="24"
            BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.3"/>
        </Border.Effect>
        <StackPanel>
            <!-- Header -->
            <Grid>
                <TextBlock Text="Customer Timeline" Style="{StaticResource HeadingLarge}" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Content="✕" Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderThickness="0" FontSize="16"
                        Command="{Binding CloseCustomerModalCommand}" Cursor="Hand"/>
            </Grid>
            <Border Height="2" CornerRadius="1" Background="{StaticResource GoldAccentGradient}" Margin="0,8,0,16" Width="100" HorizontalAlignment="Left"/>
            
            <Grid DataContext="{Binding SelectedPassenger}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer ID" Style="{StaticResource KpiLabel}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Id, StringFormat=CUS-{0:D4}}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrival Time" Style="{StaticResource KpiLabel}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArrivalTime, StringFormat={}{0:F3}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Service Start" Style="{StaticResource KpiLabel}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServiceStartTime, StringFormat={}{0:0.000;-0.000;'-'}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{StaticResource AccentGoldBrush}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Service End" Style="{StaticResource KpiLabel}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExitTime, StringFormat={}{0:0.000;-0.000;'-'}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,10"/>

                <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,14"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Wait Time (Wq)" Style="{StaticResource KpiLabel}" Margin="0,0,0,10"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding WaitTime, StringFormat={}{0:0.000;-0.000;'-'} min}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Turnaround (W)" Style="{StaticResource KpiLabel}"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SystemTime, StringFormat={}{0:0.000;-0.000;'-'} min}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
            </Grid>
        </StackPanel>
    </Border>
</Grid>

        <!-- ══ MODEL SELECTION SCREEN ════════════════════════════════════ -->
        <Grid Grid.RowSpan="3" Panel.ZIndex="998"
              Background="#E6060F06"
              Visibility="{Binding ShowModelSelection, Converter={StaticResource BoolToVisibility}}">
            <Border Width="700" Padding="30,28" CornerRadius="16"
                    BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    Background="{StaticResource CardGradient}"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#22C55E" ShadowDepth="0" BlurRadius="40" Opacity="0.15"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Gold top accent -->
                    <Border Height="3" CornerRadius="1.5" Margin="0,0,0,20"
                            Background="{StaticResource GoldAccentGradient}"/>

                    <TextBlock Text="Select Queue Model"
                               Style="{StaticResource HeadingLarge}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Choose one model to continue"
                               Style="{StaticResource BodyText}" Opacity="0.85"
                       HorizontalAlignment="Center" Margin="0,8,0,22"/>

                <UniformGrid Columns="3" Rows="1" Margin="0,0,0,14">
                        <Button Content="M/M/1"
                                Style="{StaticResource ButtonStart}"
                                Command="{Binding SelectModelCommand}"
                                CommandParameter="MM1"
                    Margin="0,0,10,0"
                    MinHeight="52" Padding="14,14"/>
                        <Button Content="M/G/1"
                                Style="{StaticResource ButtonGold}"
                                Command="{Binding SelectModelCommand}"
                                CommandParameter="MG1"
                    Margin="0,0,10,0"
                    MinHeight="52" Padding="14,14"/>
                        <Button Content="G/G/1"
                                Style="{StaticResource ButtonReset}"
                                Command="{Binding SelectModelCommand}"
                    CommandParameter="GG1"
                    MinHeight="52" Padding="14,14"/>
                    </UniformGrid>

                <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource KpiLabel}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Text="M/M/1: Poisson arrivals + exponential service  ·  M/G/1: Poisson arrivals + general service  ·  G/G/1: general arrivals + general service"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
